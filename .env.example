# Hardware mode is the default and requires a connected YubiKey 5.8.
HITL2_MODE=hardware
HITL2_HOST=localhost
HITL2_PORT=8788

# Optional. The default persistent location is ~/.hitl2.
# HITL2_DATA_DIR=/absolute/path/to/hitl2-data

# Hardware safety gate. Leave disabled unless the intended key has no FIDO PIN.
# Prefer the authenticator's management tool. If deliberately enabled, attach
# only that key, set its initial PIN once, then restart without this variable.
# HITL2_ALLOW_INITIAL_PIN=1

# Never place a FIDO PIN in this file. The app requests it only for the
# operation that needs user verification and does not persist it.
