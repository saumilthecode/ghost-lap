# Hardware mode is the default and requires a connected YubiKey 5.8.
HITL2_MODE=hardware
HITL2_HOST=localhost
HITL2_PORT=8788

# Launchers open the default browser once the server is ready. Set to 0 to opt out.
HITL2_OPEN_BROWSER=1

# Optional. The default persistent location is ~/.hitl2.
# HITL2_DATA_DIR=/absolute/path/to/hitl2-data

# If the intended key has no FIDO PIN, use the launcher's guarded setup option:
#   ./scripts/run-local.sh --setup-pin
#   .\scripts\run-local.ps1 -SetupPin
# Normal launches explicitly disable PIN setup.

# Never place a FIDO PIN in this file. The app requests it only for the
# operation that needs user verification and does not persist it.
